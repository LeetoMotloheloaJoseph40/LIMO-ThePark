    kopanyah t1, x0, 0       # count = 0
    kopanyah t2, x0, 0       # index = 0
    kopanyah t3, x0, 5       # array length = 5
    kopanyah t4, x0, 4       # element size = 4

loop:
    lekana t2, t3, done      # If index == length, finish

    # Calculate the address of array[index].
    # This version assumes the element address
    # is calculated using repeated addition.

    kopanyah t5, x0, 0       # offset = 0
    kopanyah t6, x0, 0       # counter = 0

offset_loop:
    lekana t6, t2, check     # If counter == index, continue
    kopanya t5, t5, t4       # offset = offset + 4
    kopanyah t6, t6, 1       # counter++
    tlola x0, offset_loop

check:
    kopanya t5, t0, t5       # address = base + offset
    tshela t6, 0(t5)         # Load array element

    # Parity checking requires additional
    # instructions; see explanation below.

    kopanyah t2, t2, 1       # index++
    tlola x0, loop

done
