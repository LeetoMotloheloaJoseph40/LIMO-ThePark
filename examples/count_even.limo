# count_even - counts the even numbers in a five-element array (M1 sample program 3)
# No multiply, so a[index]'s address is built by repeated addition; no andi, so the
# parity mask lives in t7.
# Expected final state: MEM[0..16] = 4, 7, 10, 3, 8; t0 = 0, t1 = 3 (the count),
#   t2 = 5, t3 = 5, t4 = 4, t5 = 16, t6 = 0, t7 = 1, n0 = 8
# N = 111, 5 stalls (one per element), 46 flushed (23 taken transfers x 2) -> 166 cycles
kopanyah n0, noto, 4      # initialise the array a[0..4] = 4, 7, 10, 3, 8
boloka n0, 0(noto)        # a[0] = 4
kopanyah n0, noto, 7
boloka n0, 4(noto)        # a[1] = 7
kopanyah n0, noto, 10
boloka n0, 8(noto)        # a[2] = 10
kopanyah n0, noto, 3
boloka n0, 12(noto)       # a[3] = 3
kopanyah n0, noto, 8
boloka n0, 16(noto)       # a[4] = 8
kopanyah t0, noto, 0      # base address = 0
kopanyah t1, noto, 0      # count = 0
kopanyah t2, noto, 0      # index = 0
kopanyah t3, noto, 5      # array length = 5
kopanyah t4, noto, 4      # element size = 4
kopanyah t7, noto, 1      # mask = 1 (LIMO has no andi)
loop: lekana t2, t3, done # if index == length, finish
kopanyah t5, noto, 0      # offset = 0
kopanyah t6, noto, 0      # counter = 0
offset_loop: lekana t6, t2, check   # if counter == index, offset is ready
kopanya t5, t5, t4        # offset = offset + 4 (no multiply)
kopanyah t6, t6, 1        # counter++
tlola noto, offset_loop   # repeat
check: kopanya t5, t0, t5 # address = base + offset
tshela t6, 0(t5)          # load a[index] (RAW on t5: forwarded)
le t6, t6, t7             # t6 = a[index] AND 1 (load-use: 1 stall)
haelekane t6, noto, skip  # odd: do not count it (RAW on t6: forwarded)
kopanyah t1, t1, 1        # even: count++
skip: kopanyah t2, t2, 1  # index++
tlola noto, loop          # next element
done: lekana noto, noto, done   # halt
