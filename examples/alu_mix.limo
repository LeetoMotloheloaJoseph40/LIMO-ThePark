# alu_mix - one use of every arithmetic and logic instruction, no hazards (new in ISA v1.1)
# Covers tlosa, kapa and chetse, which no M1 sample program used.
# Expected final state: t0 = 12, t1 = 10, t2 = 2, t3 = 14, t4 = 8, t5 = 96,
#   t6 = 0xFFFFFFFE (-2 as a signed number)
# N = 8, 0 stalls, 0 flushed -> 12 cycles
kopanyah t0, noto, 12     # t0 = 12 (0b1100)
kopanyah t1, noto, 10     # t1 = 10 (0b1010)
tlosa t2, t0, t1          # t2 = 12 - 10 = 2 (RAW on t1: forwarded)
kapa t3, t0, t1           # t3 = 12 OR 10 = 14
le t4, t0, t1             # t4 = 12 AND 10 = 8
chetse t5, t0, 3          # t5 = 12 << 3 = 96
tlosa t6, t1, t0          # t6 = 10 - 12 = -2
qeta: lekana noto, noto, qeta   # halt
